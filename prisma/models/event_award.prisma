model EventAward {
    id            String     @id @default(uuid())
    eventId       String     @map("event_id")
    event         Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
    awardType     AWARD_TYPE @default(participant) @map("award_type")
    awardTitle    String     @map("award_title")
    awardPriority Int        @map("award_priority")
    createdAt     DateTime   @default(now()) @map("created_at")

    @@map("event_awards")
    @@schema("public")
}
