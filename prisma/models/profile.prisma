model Profile {
    id                  String               @id
    fullName            String?
    email               String               @unique
    avatarUrl           String?              @map("avatar_url")
    avatarKey           String?              @map("avatar_key")
    companyName         String?              @map("company_name")
    age                 Int?
    programme           PROGRAMME?
    university          UNIVERSITY?
    degree              DEGREE?
    instagram           String?
    facebook            String?
    linkedIn            String?
    description         String?
    createdAt           DateTime             @default(now()) @map("created_at")
    updatedAt           DateTime             @updatedAt @map("updated_at")
    user                User                 @relation(fields: [id], references: [id], onDelete: Cascade)
    groupMembers        GroupMember[]
    invitations         Invitation[]
    submissionGradings  SubmissionGrading[]
    submissionReactions SubmissionReaction[]
    submissionRatings   SubmissionRating[]
    submissionFeedbacks SubmissionFeedback[]
    submissionComments  SubmissionComment[]
    userlanguage        UserLanguage[]
    provideSlots        Slot[]               @relation("SlotOwner")
    exchangeSlots       Slot[]               @relation("SlotExchangeUser")

    @@map("profiles")
    @@schema("public")
}
