model Language {
    id            String         @id @default(uuid())
    name          String         @unique
    createdAt     DateTime       @default(now()) @map("created_at")
    updatedAt     DateTime       @updatedAt @map("updated_at")
    userLanguages UserLanguage[]
    exchangeSlots Slot[]         @relation("ExchangeLanguage")
    provideSlots  Slot[]         @relation("ProvideLanguage")

    @@map("languages")
    @@schema("public")
}
