model EventGradingCriteria {
    id                  String        @id @default(uuid())
    eventId             String        @map("event_id")
    event               Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
    type                CRITERIA_TYPE @default(normal)
    criteriaName        String        @map("criteria_name")
    criteriaDescription String        @map("criteria_description")
    percentage          Float
    createdAt           DateTime      @default(now()) @map("created_at")

    submissionGradings SubmissionGrading[]

    @@map("event_grading_criteria")
    @@schema("public")
}
