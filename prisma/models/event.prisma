model Event {
    id                    String                 @id @default(uuid())
    posterPath            String?                @map("poster_path")
    title                 String
    shortDescription      String                 @map("short_description")
    status                EVENT_STATUS           @default(ongoing)
    content               String?
    location              String?
    maxGroupMembers       Int                    @map("max_group_members")
    startDate             DateTime               @default(now()) @map("start_date")
    endDate               DateTime               @default(now()) @map("end_date")
    organizedDate         DateTime               @default(now()) @map("organized_date")
    createdAt             DateTime               @default(now()) @map("created_at")
    groups                Group[]
    eventChallenges       EventChallenge[]
    eventAwards           EventAward[]
    eventGradingCriterias EventGradingCriteria[]

    @@map("events")
    @@schema("public")
}
