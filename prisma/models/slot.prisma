model Slot {
    id              String     @id @default(uuid()) @db.Uuid
    title           String
    startTime       DateTime   @map("start_time")
    endTime         DateTime   @map("end_time")
    durationMinutes Int        @map("duration_minutes")
    status          SlotStatus @default(OPEN)

    provideLanguageId String   @map("provide_language_id") @db.Uuid
    provideLanguage   Language @relation("ProvideLanguage", fields: [provideLanguageId], references: [id])

    exchangeLanguageId String   @map("exchange_language_id") @db.Uuid
    exchangeLanguage   Language @relation("ExchangeLanguage", fields: [exchangeLanguageId], references: [id])

    ownerId String  @map("owner_id") @db.Uuid
    owner   Profile @relation("SlotOwner", fields: [ownerId], references: [id])

    exchangeUserId String?   @map("exchange_user_id") @db.Uuid
    exchangeUser   Profile?  @relation("SlotExchangeUser", fields: [exchangeUserId], references: [id])
    bookedAt       DateTime? @map("booked_at")

    videoRecordUrl String?   @map("video_record_url")
    videoExpiresAt DateTime? @map("video_expire_at")

    createdAt       DateTime         @default(now()) @map("created_at")
    updatedAt       DateTime         @updatedAt @map("updated_at")
    vocabularyWords VocabularyWord[] @relation("SlotWords")
    slotRatings     SlotRating[]     @relation("SlotRating")

    @@index([startTime, status])
    @@map("slots")
    @@schema("public")
}
