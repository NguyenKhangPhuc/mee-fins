// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

enum EVENT_STATUS {
  finished
  ongoing

  @@schema("public")
}

enum PROFILE_ROLE {
  admin
  student
  judge

  @@schema("public")
}

enum UNIVERSITY {
  OAMK     @map("Oulu University of Applied Science")
  OULU_UNI @map("University of Oulu")

  @@schema("public")
}

enum PROGRAMME {
  COMPUTER_SCIENCE          @map("Computer Science and Engineering")
  INFORMATION_SCIENCE       @map("Information Processing Science")
  ELECTRONICS_COMMUNICATION @map("Electronics and Communications Engineering")
  BIOMEDICAL                @map("Biomedical Engineering")

  @@schema("public")
}

enum DEGREE {
  Bachelor
  Master
  PHD      @map("Ph.D")

  @@schema("public")
}

enum YEAR {
  FIRST_YEAR  @map("First Year")
  SECOND_YEAR @map("Second Year")
  THIRD_YEAR  @map("Third Year")
  OTHER       @map("Other")

  @@schema("public")
}

enum INVITATION_STATUS {
  pending
  rejected
  accepted

  @@schema("public")
}

enum CRITERIA_TYPE {
  normal
  specific

  @@schema("public")
}

enum AWARD_TYPE {
  general
  specific
  participant

  @@schema("public")
}

enum PROJECT_STATUS {
  pending
  rejected
  accepted

  @@schema("public")
}

model User {
  id             String         @id @default(uuid())
  displayName    String?        @map("display_name")
  email          String         @unique
  passwordHash   String?        @map("password_hash")
  confirmationAt DateTime?      @map("confirmation_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  profile        Profile?
  refreshTokens  RefreshToken[]
  sessions       Session[]

  @@map("users")
  @@schema("auth")
}

model RefreshToken {
  id        String   @id @default(uuid())
  jti       String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRevoked Boolean  @default(false) @map("is_revoked")
  updatedAt DateTime @default(now()) @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")
  sessionId String   @map("session_id")
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
  @@schema("auth")
}

model Session {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent     String?        @map("user_agent")
  ipAddress     String?        @map("ip_address")
  createdAt     DateTime       @default(now()) @map("created_at")
  refreshedAt   DateTime?      @map("refreshed_at")
  refreshTokens RefreshToken[]

  @@map("sessions")
  @@schema("auth")
}
